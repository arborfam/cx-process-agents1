# Приклад налаштувань. Значення секретів сюди НЕ записувати; справжній .env у git не потрапляє.
# Режим роботи з моделлю: demo (зріз 1 підтримує лише його) або real (зріз 2, потрібен ключ)
MODEL_MODE=demo
# Порт (0 = вільний порт)
PORT=3000
# Де лежить база кейсів
CX_DB_PATH=data/cx.sqlite
# Ключ моделі потрібен лише для MODEL_MODE=real (зріз 2). Не заповнювати тут.
# ANTHROPIC_API_KEY=
