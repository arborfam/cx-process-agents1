  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Обробка скарги «Клієнт &amp; Ко» (&lt;тест&gt; &quot;лапки&quot; 'апостроф')" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:extensionElements>
      <cx:asIsBinding versionId="TEST-P05-V1" contentHash="f6b1149a19fc9649c6f0be9e3b90768e71c071254ef4e884b4a7c35f876fdaea" origin="test-fixture" generator="cx-bpmn-generator-3a" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Менеджер &quot;ключових&quot; клієнтів">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_S4_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Аналітик &amp; контролер якості">
        <bpmn:flowNodeRef>Task_S3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Фахівець &lt;L2&gt;">
        <bpmn:flowNodeRef>Task_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_S5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_S5_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Клієнт написав у чаті: &quot;Де моє замовлення?&quot;">
      <bpmn:outgoing>Flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_S1" name="Реєструє скаргу: «затримка доставки» (замовлення №12-345/А)">
      <bpmn:incoming>Flow_start</bpmn:incoming>
      <bpmn:outgoing>Flow_S1_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_S2" name="Перевіряє суму: якщо a &lt; b &amp;&amp; b &gt; c — виділяє &lt;b&gt;жирним&lt;/b&gt; у картці; знижка 100% - 15% ✅">
      <bpmn:incoming>Flow_S1_1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2_g</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_S2">
      <bpmn:incoming>Flow_S2_g</bpmn:incoming>
      <bpmn:outgoing>Flow_S2_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_S2_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_S2_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_S3" name="Фахівець послідовно перевіряє всі вкладення до скарги: скановані копії договору, листування з клієнтом за останні дванадцять місяців, історію платежів та записи розмов із підтримкою, зіставляє дати й суми, виявляє розбіжності та складає докладний висновок для керівника напряму, зазначаючи джерело кожного твердження">
      <bpmn:incoming>Flow_S2_1</bpmn:incoming>
      <bpmn:outgoing>Flow_S3_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_S4" name="Пише клієнту:&#10;Дякуємо за відповідь,&#10;ми закриваємо звернення">
      <bpmn:incoming>Flow_S2_2</bpmn:incoming>
      <bpmn:outgoing>Flow_S4_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_S4_1">
      <bpmn:incoming>Flow_S4_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_S5" name="Складає відповідь клієнту з урахуванням правил &quot;A &amp; B&quot; і 'C'">
      <bpmn:incoming>Flow_S2_3</bpmn:incoming>
      <bpmn:incoming>Flow_S3_1</bpmn:incoming>
      <bpmn:outgoing>Flow_S5_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_S5_1">
      <bpmn:incoming>Flow_S5_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start" sourceRef="StartEvent_1" targetRef="Task_S1" />
    <bpmn:sequenceFlow id="Flow_S1_1" sourceRef="Task_S1" targetRef="Task_S2" />
    <bpmn:sequenceFlow id="Flow_S2_g" sourceRef="Task_S2" targetRef="Gateway_S2" />
    <bpmn:sequenceFlow id="Flow_S2_1" name="сума &gt; 1000 грн" sourceRef="Gateway_S2" targetRef="Task_S3" />
    <bpmn:sequenceFlow id="Flow_S2_2" name="клієнт сказав &quot;ні&quot;" sourceRef="Gateway_S2" targetRef="Task_S4" />
    <bpmn:sequenceFlow id="Flow_S2_3" name="потрібне уточнення: 'так' чи 'ні'?" sourceRef="Gateway_S2" targetRef="Task_S5" />
    <bpmn:sequenceFlow id="Flow_S3_1" sourceRef="Task_S3" targetRef="Task_S5" />
    <bpmn:sequenceFlow id="Flow_S4_1" sourceRef="Task_S4" targetRef="End_S4_1" />
    <bpmn:sequenceFlow id="Flow_S5_1" sourceRef="Task_S5" targetRef="End_S5_1" />
  </bpmn:process>
