      <bpmn:incoming>fTask_S5_Gateway_S5</bpmn:incoming>
      <bpmn:outgoing>fGateway_S5_Task_S6</bpmn:outgoing>
      <bpmn:outgoing>fGateway_S5_Task_S7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_S6" name="Створити статтю в базі знань">
