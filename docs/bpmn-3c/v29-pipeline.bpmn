      <bpmn:outgoing>fTask_S7_Task_S8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_S8" name="Підготувати повідомлення агентам">
      <bpmn:incoming>fTask_S6_Task_S8</bpmn:incoming>
      <bpmn:incoming>fTask_S7_Task_S8</bpmn:incoming>
      <bpmn:outgoing>fTask_S8_Gateway_S8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_S8">
      <bpmn:incoming>fTask_S8_Gateway_S8</bpmn:incoming>
      <bpmn:outgoing>fGateway_S8_Task_S12</bpmn:outgoing>
      <bpmn:outgoing>fGateway_S8_Task_S17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_S12" name="Повторно запитати овнера про відсутні матеріали">
      <bpmn:incoming>fGateway_S8_Task_S12</bpmn:incoming>
      <bpmn:outgoing>fTask_S12_Task_S13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_S17" name="Перевірити, чи є пряме підтвердження дати запуску">
