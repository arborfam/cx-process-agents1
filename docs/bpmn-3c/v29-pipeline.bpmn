      <bpmn:outgoing>fGateway_S17_Task_S18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_S13" name="Доповнити статтю й повідомлення за відповіддю овнера">
      <bpmn:incoming>fTask_S12_Task_S13</bpmn:incoming>
      <bpmn:outgoing>fTask_S13_Task_S17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_S19" name="Перевірити, чи зміну не перенесено й не скасовано">
